# Configuración del Backend - Copia este archivo a CONTACT-FORM-BACKEND/.env
# y completa con tus datos reales

# Configuración de Gmail
# Para obtener la contraseña de aplicación: https://myaccount.google.com/apppasswords
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-contraseña-app-gmail

# Puerto del servidor (por defecto 5000)
PORT=5000

# Ejemplo con valores reales (NO SUBIR ESTO A REPOSITORIO):
# EMAIL_USER=miempresa@gmail.com
# EMAIL_PASS=abcd efgh ijkl mnop
# PORT=5000
